{
  "manifest_version": 3,
  "name": "Vídeo em Foco — Importar transcrição",
  "version": "1.0.3",
  "description": "Importa a transcrição visível de uma página do YouTube para o Vídeo em Foco local.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_title": "Importar para Vídeo em Foco",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ]
}
